  "lines": [
    {"id": "01-gancho", "frame": 8, "gapAfter": 8, "text": "Você sabia que a Microsoft começou faturando apenas dezesseis mil dólares e poucos anos depois estava dentro dos computadores da IBM?", "durationInFrames": 227, "words": [{"w": "Você", "s": 4, "e": 12}, {"w": "sabia", "s": 13, "e": 26}, {"w": "que", "s": 26, "e": 29}, {"w": "a", "s": 29, "e": 30}, {"w": "Microsoft", "s": 30, "e": 50}, {"w": "começou", "s": 51, "e": 62}, {"w": "faturando", "s": 62, "e": 74}, {"w": "apenas", "s": 74, "e": 84}, {"w": "dezesseis", "s": 84, "e": 97}, {"w": "mil", "s": 97, "e": 102}, {"w": "dólares", "s": 102, "e": 112}, {"w": "e", "s": 113, "e": 116}, {"w": "poucos", "s": 116, "e": 125}, {"w": "anos", "s": 125, "e": 134}, {"w": "depois", "s": 135, "e": 144}, {"w": "estava", "s": 144, "e": 156}, {"w": "dentro", "s": 156, "e": 164}, {"w": "dos", "s": 164, "e": 169}, {"w": "computadores", "s": 169, "e": 187}, {"w": "da", "s": 187, "e": 191}, {"w": "IBM?", "s": 192, "e": 206}], "wordsMatched": "21/21", "wordsEngine": "edge-tts WordBoundary (sem ASR: faster-whisper ausente)"},
    {"id": "02-1975", "frame": 243, "gapAfter": 5, "text": "Em mil novecentos e setenta e cinco, Bill Gates tinha dezenove anos.", "durationInFrames": 129, "words": [{"w": "Em", "s": 4, "e": 9}, {"w": "mil", "s": 9, "e": 13}, {"w": "novecentos", "s": 13, "e": 29}, {"w": "e", "s": 29, "e": 31}, {"w": "setenta", "s": 31, "e": 40}, {"w": "e", "s": 40, "e": 41}, {"w": "cinco,", "s": 41, "e": 52}, {"w": "Bill", "s": 59, "e": 64}, {"w": "Gates", "s": 65, "e": 77}, {"w": "tinha", "s": 77, "e": 83}, {"w": "dezenove", "s": 83, "e": 97}, {"w": "anos.", "s": 97, "e": 107}], "wordsMatched": "12/12", "wordsEngine": "edge-tts WordBoundary (sem ASR: faster-whisper ausente)"},
    {"id": "03-allen", "frame": 377, "gapAfter": 5, "text": "Paul Allen tinha vinte e dois.", "durationInFrames": 67, "words": [{"w": "Paul", "s": 5, "e": 10}, {"w": "Allen", "s": 10, "e": 18}, {"w": "tinha", "s": 18, "e": 26}, {"w": "vinte", "s": 26, "e": 34}, {"w": "e", "s": 34, "e": 35}, {"w": "dois.", "s": 35, "e": 46}], "wordsMatched": "6/6", "wordsEngine": "edge-tts WordBoundary (sem ASR: faster-whisper ausente)"},
    {"id": "04-altair", "frame": 449, "gapAfter": 14, "text": "Os dois criaram um programa para um computador chamado Altair 8800.", "durationInFrames": 147, "words": [{"w": "Os", "s": 4, "e": 9}, {"w": "dois", "s": 9, "e": 18}, {"w": "criaram", "s": 18, "e": 29}, {"w": "um", "s": 29, "e": 31}, {"w": "programa", "s": 31, "e": 45}, {"w": "para", "s": 45, "e": 50}, {"w": "um", "s": 50, "e": 51}, {"w": "computador", "s": 52, "e": 68}, {"w": "chamado", "s": 68, "e": 80}, {"w": "Altair", "s": 80, "e": 91}, {"w": "8800.", "s": 91, "e": 125}], "wordsMatched": "11/11", "wordsEngine": "edge-tts WordBoundary (sem ASR: faster-whisper ausente)"},
    {"id": "05-primeiro", "frame": 610, "gapAfter": 14, "text": "Naquele primeiro ano? Só dezesseis mil dólares em vendas.", "durationInFrames": 137, "words": [{"w": "Naquele", "s": 4, "e": 17}, {"w": "primeiro", "s": 17, "e": 28}, {"w": "ano?", "s": 28, "e": 36}, {"w": "Só", "s": 58, "e": 65}, {"w": "dezesseis", "s": 65, "e": 79}, {"w": "mil", "s": 79, "e": 84}, {"w": "dólares", "s": 85, "e": 95}, {"w": "em", "s": 95, "e": 100}, {"w": "vendas.", "s": 100, "e": 115}], "wordsMatched": "9/9", "wordsEngine": "edge-tts WordBoundary (sem ASR: faster-whisper ausente)"},
    {"id": "06-virada", "frame": 761, "gapAfter": 5, "text": "Mas cinco anos depois aconteceu algo gigantesco.", "durationInFrames": 105, "words": [{"w": "Mas", "s": 5, "e": 13}, {"w": "cinco", "s": 13, "e": 22}, {"w": "anos", "s": 23, "e": 30}, {"w": "depois", "s": 30, "e": 39}, {"w": "aconteceu", "s": 39, "e": 57}, {"w": "algo", "s": 57, "e": 64}, {"w": "gigantesco.", "s": 64, "e": 84}], "wordsMatched": "7/7", "wordsEngine": "edge-tts WordBoundary (sem ASR: faster-whisper ausente)"},
    {"id": "07-ibm", "frame": 871, "gapAfter": 14, "text": "Uma empresa chamada IBM estava entrando no mercado de computadores pessoais e procurou a Microsoft para fornecer o sistema operacional.", "durationInFrames": 222, "words": [{"w": "Uma", "s": 4, "e": 9}, {"w": "empresa", "s": 9, "e": 20}, {"w": "chamada", "s": 21, "e": 32}, {"w": "IBM", "s": 32, "e": 44}, {"w": "estava", "s": 44, "e": 51}, {"w": "entrando", "s": 52, "e": 63}, {"w": "no", "s": 63, "e": 65}, {"w": "mercado", "s": 66, "e": 79}, {"w": "de", "s": 79, "e": 81}, {"w": "computadores", "s": 82, "e": 100}, {"w": "pessoais", "s": 100, "e": 113}, {"w": "e", "s": 113, "e": 116}, {"w": "procurou", "s": 116, "e": 127}, {"w": "a", "s": 128, "e": 129}, {"w": "Microsoft", "s": 129, "e": 150}, {"w": "para", "s": 150, "e": 155}, {"w": "fornecer", "s": 155, "e": 169}, {"w": "o", "s": 170, "e": 171}, {"w": "sistema", "s": 171, "e": 182}, {"w": "operacional.", "s": 182, "e": 200}], "wordsMatched": "20/20", "wordsEngine": "edge-tts WordBoundary (sem ASR: faster-whisper ausente)"},
    {"id": "08-1981", "frame": 1107, "gapAfter": 14, "text": "Em mil novecentos e oitenta e um, as vendas da Microsoft já tinham saltado para dezessete milhões e trezentos mil dólares.", "durationInFrames": 207, "words": [{"w": "Em", "s": 4, "e": 8}, {"w": "mil", "s": 9, "e": 12}, {"w": "novecentos", "s": 12, "e": 27}, {"w": "e", "s": 28, "e": 30}, {"w": "oitenta", "s": 31, "e": 38}, {"w": "e", "s": 39, "e": 40}, {"w": "um,", "s": 40, "e": 44}, {"w": "as", "s": 51, "e": 56}, {"w": "vendas", "s": 56, "e": 65}, {"w": "da", "s": 65, "e": 68}, {"w": "Microsoft", "s": 68, "e": 88}, {"w": "já", "s": 89, "e": 93}, {"w": "tinham", "s": 93, "e": 100}, {"w": "saltado", "s": 101, "e": 115}, {"w": "para", "s": 115, "e": 120}, {"w": "dezessete", "s": 121, "e": 135}, {"w": "milhões", "s": 136, "e": 146}, {"w": "e", "s": 146, "e": 149}, {"w": "trezentos", "s": 149, "e": 165}, {"w": "mil", "s": 165, "e": 170}, {"w": "dólares.", "s": 171, "e": 185}], "wordsMatched": "21/21", "wordsEngine": "edge-tts WordBoundary (sem ASR: faster-whisper ausente)"},
    {"id": "09-final", "frame": 1328, "gapAfter": 5, "text": "De dezesseis mil para dezessete milhões e trezentos mil dólares em poucos anos. E aquilo ainda era o começo.", "durationInFrames": 208, "words": [{"w": "De", "s": 4, "e": 9}, {"w": "dezesseis", "s": 9, "e": 23}, {"w": "mil", "s": 23, "e": 29}, {"w": "para", "s": 29, "e": 34}, {"w": "dezessete", "s": 35, "e": 49}, {"w": "milhões", "s": 49, "e": 58}, {"w": "e", "s": 59, "e": 62}, {"w": "trezentos", "s": 62, "e": 76}, {"w": "mil", "s": 76, "e": 81}, {"w": "dólares", "s": 82, "e": 91}, {"w": "em", "s": 92, "e": 97}, {"w": "poucos", "s": 97, "e": 106}, {"w": "anos.", "s": 107, "e": 119}, {"w": "E", "s": 142, "e": 145}, {"w": "aquilo", "s": 145, "e": 156}, {"w": "ainda", "s": 156, "e": 166}, {"w": "era", "s": 166, "e": 171}, {"w": "o", "s": 171, "e": 172}, {"w": "começo.", "s": 172, "e": 186}], "wordsMatched": "19/19", "wordsEngine": "edge-tts WordBoundary (sem ASR: faster-whisper ausente)"},
    {"id": "10-fecho", "frame": 1541, "gapAfter": 5, "text": "Dois jovens escrevendo código acabaram colocando seu software nos computadores da IBM.", "durationInFrames": 159, "words": [{"w": "Dois", "s": 4, "e": 13}, {"w": "jovens", "s": 13, "e": 23}, {"w": "escrevendo", "s": 23, "e": 39}, {"w": "código", "s": 40, "e": 49}, {"w": "acabaram", "s": 49, "e": 60}, {"w": "colocando", "s": 60, "e": 74}, {"w": "seu", "s": 75, "e": 79}, {"w": "software", "s": 80, "e": 95}, {"w": "nos", "s": 95, "e": 99}, {"w": "computadores", "s": 100, "e": 119}, {"w": "da", "s": 119, "e": 123}, {"w": "IBM.", "s": 124, "e": 137}], "wordsMatched": "12/12", "wordsEngine": "edge-tts WordBoundary (sem ASR: faster-whisper ausente)"}
