  "lines": [
    {"id": "01-gancho", "frame": 8, "gapAfter": 8, "text": "Você sabia que uma das maiores concorrentes da OpenAI nasceu depois que pessoas importantes da própria OpenAI saíram da empresa?", "durationInFrames": 214, "words": [{"w": "Você", "s": 4, "e": 12}, {"w": "sabia", "s": 12, "e": 26}, {"w": "que", "s": 26, "e": 29}, {"w": "uma", "s": 29, "e": 33}, {"w": "das", "s": 33, "e": 37}, {"w": "maiores", "s": 37, "e": 49}, {"w": "concorrentes", "s": 50, "e": 67}, {"w": "da", "s": 67, "e": 72}, {"w": "OpenAI", "s": 72, "e": 85}, {"w": "nasceu", "s": 85, "e": 94}, {"w": "depois", "s": 95, "e": 105}, {"w": "que", "s": 105, "e": 108}, {"w": "pessoas", "s": 108, "e": 118}, {"w": "importantes", "s": 119, "e": 138}, {"w": "da", "s": 139, "e": 142}, {"w": "própria", "s": 142, "e": 151}, {"w": "OpenAI", "s": 152, "e": 165}, {"w": "saíram", "s": 165, "e": 176}, {"w": "da", "s": 177, "e": 179}, {"w": "empresa?", "s": 179, "e": 192}], "wordsMatched": "20/20", "wordsEngine": "edge-tts WordBoundary (sem ASR: faster-whisper ausente)"},
    {"id": "02-dario", "frame": 230, "gapAfter": 5, "text": "Um deles era Dario Amodei.", "durationInFrames": 67, "words": [{"w": "Um", "s": 4, "e": 9}, {"w": "deles", "s": 9, "e": 18}, {"w": "era", "s": 18, "e": 25}, {"w": "Dario", "s": 26, "e": 32}, {"w": "Amodei.", "s": 32, "e": 45}], "wordsMatched": "5/5", "wordsEngine": "edge-tts WordBoundary (sem ASR: faster-whisper ausente)"},
    {"id": "03-pesquisa", "frame": 302, "gapAfter": 14, "text": "Ele trabalhava na OpenAI e chegou a liderar pesquisas importantes de segurança e desenvolvimento de modelos.", "durationInFrames": 180, "words": [{"w": "Ele", "s": 4, "e": 10}, {"w": "trabalhava", "s": 10, "e": 26}, {"w": "na", "s": 26, "e": 29}, {"w": "OpenAI", "s": 30, "e": 45}, {"w": "e", "s": 45, "e": 46}, {"w": "chegou", "s": 46, "e": 55}, {"w": "a", "s": 55, "e": 56}, {"w": "liderar", "s": 56, "e": 66}, {"w": "pesquisas", "s": 67, "e": 79}, {"w": "importantes", "s": 80, "e": 99}, {"w": "de", "s": 99, "e": 102}, {"w": "segurança", "s": 102, "e": 118}, {"w": "e", "s": 119, "e": 120}, {"w": "desenvolvimento", "s": 120, "e": 140}, {"w": "de", "s": 140, "e": 142}, {"w": "modelos.", "s": 142, "e": 158}], "wordsMatched": "16/16", "wordsEngine": "edge-tts WordBoundary (sem ASR: faster-whisper ausente)"},
    {"id": "04-saida", "frame": 496, "gapAfter": 5, "text": "Mas em dois mil e vinte e um, Dario, sua irmã Daniela e outros pesquisadores deixaram a OpenAI.", "durationInFrames": 174, "words": [{"w": "Mas", "s": 4, "e": 10}, {"w": "em", "s": 10, "e": 14}, {"w": "dois", "s": 14, "e": 20}, {"w": "mil", "s": 20, "e": 23}, {"w": "e", "s": 24, "e": 25}, {"w": "vinte", "s": 25, "e": 32}, {"w": "e", "s": 32, "e": 33}, {"w": "um,", "s": 33, "e": 37}, {"w": "Dario,", "s": 43, "e": 52}, {"w": "sua", "s": 59, "e": 63}, {"w": "irmã", "s": 63, "e": 71}, {"w": "Daniela", "s": 72, "e": 86}, {"w": "e", "s": 86, "e": 88}, {"w": "outros", "s": 88, "e": 97}, {"w": "pesquisadores", "s": 98, "e": 118}, {"w": "deixaram", "s": 118, "e": 131}, {"w": "a", "s": 131, "e": 133}, {"w": "OpenAI.", "s": 134, "e": 152}], "wordsMatched": "18/18", "wordsEngine": "edge-tts WordBoundary (sem ASR: faster-whisper ausente)"},
    {"id": "05-nova", "frame": 675, "gapAfter": 14, "text": "E criaram uma nova empresa. A Anthropic.", "durationInFrames": 110, "words": [{"w": "E", "s": 4, "e": 7}, {"w": "criaram", "s": 8, "e": 21}, {"w": "uma", "s": 21, "e": 25}, {"w": "nova", "s": 25, "e": 33}, {"w": "empresa.", "s": 33, "e": 46}, {"w": "A", "s": 68, "e": 71}, {"w": "Anthropic.", "s": 71, "e": 88}], "wordsMatched": "7/7", "wordsEngine": "edge-tts WordBoundary (sem ASR: faster-whisper ausente)"},
    {"id": "06-startup", "frame": 799, "gapAfter": 5, "text": "E eles não começaram com uma simples startup.", "durationInFrames": 97, "words": [{"w": "E", "s": 4, "e": 7}, {"w": "eles", "s": 8, "e": 13}, {"w": "não", "s": 13, "e": 18}, {"w": "começaram", "s": 18, "e": 35}, {"w": "com", "s": 35, "e": 39}, {"w": "uma", "s": 40, "e": 43}, {"w": "simples", "s": 44, "e": 55}, {"w": "startup.", "s": 55, "e": 75}], "wordsMatched": "8/8", "wordsEngine": "edge-tts WordBoundary (sem ASR: faster-whisper ausente)"},
    {"id": "07-124", "frame": 901, "gapAfter": 14, "text": "Já no primeiro ano, a Anthropic levantou cento e vinte e quatro milhões de dólares para desenvolver uma nova geração de inteligência artificial.", "durationInFrames": 220, "words": [{"w": "Já", "s": 4, "e": 10}, {"w": "no", "s": 10, "e": 13}, {"w": "primeiro", "s": 13, "e": 24}, {"w": "ano,", "s": 24, "e": 31}, {"w": "a", "s": 38, "e": 40}, {"w": "Anthropic", "s": 40, "e": 56}, {"w": "levantou", "s": 56, "e": 69}, {"w": "cento", "s": 69, "e": 80}, {"w": "e", "s": 80, "e": 81}, {"w": "vinte", "s": 81, "e": 86}, {"w": "e", "s": 87, "e": 88}, {"w": "quatro", "s": 87, "e": 96}, {"w": "milhões", "s": 96, "e": 105}, {"w": "de", "s": 105, "e": 107}, {"w": "dólares", "s": 107, "e": 118}, {"w": "para", "s": 118, "e": 123}, {"w": "desenvolver", "s": 123, "e": 137}, {"w": "uma", "s": 137, "e": 141}, {"w": "nova", "s": 141, "e": 149}, {"w": "geração", "s": 149, "e": 161}, {"w": "de", "s": 161, "e": 164}, {"w": "inteligência", "s": 164, "e": 181}, {"w": "artificial.", "s": 181, "e": 198}], "wordsMatched": "23/23", "wordsEngine": "edge-tts WordBoundary (sem ASR: faster-whisper ausente)"},
    {"id": "08-claude", "frame": 1135, "gapAfter": 14, "text": "Dois anos depois, eles lançaram o Claude. E começaram a competir diretamente no mercado de IA.", "durationInFrames": 227, "words": [{"w": "Dois", "s": 4, "e": 11}, {"w": "anos", "s": 12, "e": 22}, {"w": "depois,", "s": 22, "e": 35}, {"w": "eles", "s": 41, "e": 46}, {"w": "lançaram", "s": 46, "e": 61}, {"w": "o", "s": 62, "e": 63}, {"w": "Claude.", "s": 63, "e": 75}, {"w": "E", "s": 97, "e": 100}, {"w": "começaram", "s": 100, "e": 117}, {"w": "a", "s": 117, "e": 118}, {"w": "competir", "s": 119, "e": 132}, {"w": "diretamente", "s": 133, "e": 151}, {"w": "no", "s": 152, "e": 153}, {"w": "mercado", "s": 154, "e": 167}, {"w": "de", "s": 167, "e": 170}, {"w": "IA.", "s": 170, "e": 205}], "wordsMatched": "16/16", "wordsEngine": "edge-tts WordBoundary (sem ASR: faster-whisper ausente)"},
    {"id": "09-183", "frame": 1376, "gapAfter": 5, "text": "Em dois mil e vinte e cinco, a empresa já tinha sido avaliada em cento e oitenta e três bilhões de dólares.", "durationInFrames": 170, "words": [{"w": "Em", "s": 4, "e": 7}, {"w": "dois", "s": 8, "e": 14}, {"w": "mil", "s": 14, "e": 17}, {"w": "e", "s": 17, "e": 19}, {"w": "vinte", "s": 19, "e": 25}, {"w": "e", "s": 25, "e": 26}, {"w": "cinco,", "s": 26, "e": 38}, {"w": "a", "s": 41, "e": 43}, {"w": "empresa", "s": 43, "e": 56}, {"w": "já", "s": 57, "e": 60}, {"w": "tinha", "s": 60, "e": 68}, {"w": "sido", "s": 68, "e": 75}, {"w": "avaliada", "s": 75, "e": 89}, {"w": "em", "s": 89, "e": 92}, {"w": "cento", "s": 93, "e": 101}, {"w": "e", "s": 101, "e": 102}, {"w": "oitenta", "s": 102, "e": 110}, {"w": "e", "s": 110, "e": 111}, {"w": "três", "s": 111, "e": 118}, {"w": "bilhões", "s": 118, "e": 131}, {"w": "de", "s": 131, "e": 133}, {"w": "dólares.", "s": 134, "e": 148}], "wordsMatched": "22/22", "wordsEngine": "edge-tts WordBoundary (sem ASR: faster-whisper ausente)"},
